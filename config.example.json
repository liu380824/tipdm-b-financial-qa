{
  "database": {
    "path": "financial_reports.db"
  },
  "reports_dir": "<附件2：财务报告 所在目录，例如 ./data/附件2：财务报告>",
  "research_reports_dir": "<附件5：研报数据 所在目录，例如 ./data/附件5：研报数据>",
  "embedding": {
    "api_key": "<你的 Embedding 服务密钥，推荐使用环境变量注入>",
    "base_url": "https://api.siliconflow.cn/v1",
    "model": "BAAI/bge-m3",
    "reranker_model": "BAAI/bge-reranker-v2-m3"
  },
  "llm": {
    "api_key": "<你的大模型服务密钥>",
    "base_url": "https://api.siliconflow.cn/v1",
    "model": "Pro/deepseek-ai/DeepSeek-V3",
    "request_timeout": 120,
    "intent_temperature": 0.1,
    "query_plan_temperature": 0.1,
    "analysis_temperature": 0.3,
    "general_reply_temperature": 0.4,
    "planner_decompose_temperature": 0.1,
    "synthesis_temperature": 0.4,
    "ref_extract_temperature": 0.1
  },
  "intent_llm": {
    "api_key": "<你的大模型服务密钥>",
    "base_url": "https://api.siliconflow.cn/v1",
    "model": "Qwen/Qwen2.5-72B-Instruct",
    "request_timeout": 60
  },
  "extract_llm": {
    "api_key": "<你的大模型服务密钥>",
    "base_url": "https://api.siliconflow.cn/v1",
    "model": "Qwen/Qwen2.5-72B-Instruct",
    "request_timeout": 120
  },
  "parallel": {
    "max_workers": 4
  },
  "stock_abbr_to_code": {
    "凯莱英": "002821",
    "百普赛斯": "301080",
