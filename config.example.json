  "knowledge_base": {
    "index_concurrency": 4,
    "embed_batch_size": 64,
    "embed_max_chars": 2000,
    "child_chunk_min": 100,
    "child_chunk_max": 300,
    "parent_chunk_max": 900,
    "chunk_overlap": 50,
    "ocr_dpi": 200,
    "ocr_workers": 4,
    "bm25_weight": 0.3,
    "vector_weight": 0.7,
    "rrf_k": 60,
    "rerank_candidates": 30,
    "top_k": 5
